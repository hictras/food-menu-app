<!-- English Cards -->
<div class="cards-container lang-cards" id="en-cards">
  {% for title in titles %}
    {% assign idx = forloop.index0 %}
    <div class="recipe-card {% if forloop.first %}active{% endif %}" id="day-{{ forloop.index }}" data-type="{{ types[idx] }}">

      <div class="card-inner">
        <div class="day-badge">DAY {{ forloop.index }}</div>

        <div class="recipe-title-row">
          <h2>{{ title }}</h2>
          <div class="drink-tag">🥤 {{ drinks[idx] }}</div>
        </div>

        <div class="starter-row">
          <strong>🥗 Side & Starter:</strong> {{ sides[idx] }}
        </div>

        <div class="grid-layout">
          <div class="grid-column">
            <h3>📝 Ingredients</h3>
            <p>{{ ingredients[idx] }}</p>
          </div>
          <div class="grid-column">
            <h3>👩‍🍳 Preparation</h3>
            <p>{{ methods[idx] }}</p>
          </div>
        </div>

        <div class="shopping-list-toggle no-print">
          {% assign shop_idx = forloop.index | minus: 1 | divided_by: 6 | floor %}
          <button class="btn-shop" onclick="this.nextElementSibling.classList.toggle('show')">🛒 View Weekly Shopping List</button>
          <div class="shop-content">
            <strong>Essentials for this week:</strong><br>{{ shopping[shop_idx] }}
          </div>
        </div>
      </div>
    </div>
  {% endfor %}
</div>

<!-- Arabic Cards (hidden by default) -->
<div class="cards-container lang-cards" id="ar-cards" style="display: none;">
  {% for title in titles_ar %}
    {% assign idx = forloop.index0 %}
    <div class="recipe-card {% if forloop.first %}active{% endif %}" id="day-ar-{{ forloop.index }}" data-type="{{ types_ar[idx] }}">

      <div class="card-inner">
        <div class="day-badge">اليوم {{ forloop.index }}</div>

