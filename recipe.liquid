<script>
function showDay(day, btn) {
  // Get current language
  const currentLang = document.querySelector('.lang-btn.active')?.textContent.includes('العربية') ? 'ar' : 'en';

  // 1. Hide all recipes and deactivate all dots
  document.querySelectorAll('.recipe-card').forEach(card => card.classList.remove('active'));
  document.querySelectorAll('.nav-dot').forEach(dot => dot.classList.remove('active'));

  // 2. Show the specific day based on language
  let targetRecipe;
  if (currentLang === 'ar') {
    targetRecipe = document.getElementById('day-ar-' + day);
  } else {
    targetRecipe = document.getElementById('day-' + day);
  }

  if (!targetRecipe) return; // Exit if recipe not found

  targetRecipe.classList.add('active');
  btn.classList.add('active');

  // 3. AUTO-SCROLL to the recipe
  const offset = 100;
  const bodyRect = document.body.getBoundingClientRect().top;
  const elementRect = targetRecipe.getBoundingClientRect().top;
  const elementPosition = elementRect - bodyRect;
  const offsetPosition = elementPosition - offset;

  window.scrollTo({
    top: offsetPosition,
    behavior: 'smooth'
  });
}

function filterDay(type, event) {
  if (!event) return;

  // Deactivate all filter buttons in current language
  const currentLang = document.querySelector('.lang-btn.active')?.textContent.includes('العربية') ? 'ar' : 'en';

  if (currentLang === 'en') {
    document.querySelectorAll('#filter-en .filter-btn').forEach(b => b.classList.remove('active'));
  } else {
    document.querySelectorAll('#filter-ar .filter-btn').forEach(b => b.classList.remove('active'));
  }

  // Activate clicked button
  event.target.classList.add('active');

  // Select cards based on current language
  let cards;
  if (currentLang === 'ar') {
    cards = document.querySelectorAll('#ar-cards .recipe-card');
  } else {
    cards = document.querySelectorAll('#en-cards .recipe-card');
  }

  let firstVisible = null;

  // First, hide all dots
  document.querySelectorAll('.nav-dot').forEach(dot => {
    dot.style.display = 'none';
  });

  // Then show only dots for matching cards
  cards.forEach(card => {
    const dayId = card.id.split('-').pop();
    const dot = document.getElementById('btn-' + dayId);

    if (dot) {
      if (type === 'all' || card.getAttribute('data-type') === type) {
        dot.style.display = 'inline-flex';
        if (!firstVisible) firstVisible = {dayId, dot};
      }
    }
  });

  // If no dots visible, show first dot as fallback
  if (!firstVisible) {
    const firstDot = document.querySelector('.nav-dot');
    if (firstDot) {
      firstDot.style.display = 'inline-flex';
      const dayId = firstDot.id.replace('btn-', '');
      firstVisible = {dayId, dot: firstDot};
    }
  }

  if (firstVisible) showDay(firstVisible.dayId, firstVisible.dot);
}

function switchLanguage(lang, skipDaySelection = false) {
  // Get currently active day before switching (only if we're not skipping)
  let activeDay = null;
  if (!skipDaySelection) {
    const currentActiveDot = document.querySelector('.nav-dot.active');
    if (currentActiveDot) {
      activeDay = currentActiveDot.id.replace('btn-', '');
    }
  }

  // Update button states
  document.querySelectorAll('.lang-btn').forEach(btn => {
    btn.classList.remove('active');
  });

  if (lang === 'en') {
    // Activate English button
    document.querySelector('[onclick="switchLanguage(\'en\')"]').classList.add('active');

    document.getElementById('day-selector-wrapper').style.direction = 'ltr';

    // Show English header, hide Arabic header
    document.getElementById('header-en').style.display = 'block';
    document.getElementById('header-ar').style.display = 'none';

    // Show English filter, hide Arabic filter
    document.getElementById('filter-en').style.display = 'flex';
    document.getElementById('filter-ar').style.display = 'none';

    // Show English cards, hide Arabic cards
    document.getElementById('en-cards').style.display = 'block';
    document.getElementById('ar-cards').style.display = 'none';

    // Show English day text, hide Arabic day text
    document.querySelectorAll('.day-text-en').forEach(el => el.style.display = 'inline');
    document.querySelectorAll('.day-text-ar').forEach(el => el.style.display = 'none');

    document.documentElement.lang = 'en';

  } else {
    // Activate Arabic button
    document.querySelector('[onclick="switchLanguage(\'ar\')"]').classList.add('active');

    document.getElementById('day-selector-wrapper').style.direction = 'rtl';

    // Show Arabic header, hide English header
    document.getElementById('header-en').style.display = 'none';
    document.getElementById('header-ar').style.display = 'block';

    // Show Arabic filter, hide English filter
    document.getElementById('filter-en').style.display = 'none';
    document.getElementById('filter-ar').style.display = 'flex';

    // Show Arabic cards, hide English cards
    document.getElementById('en-cards').style.display = 'none';
    document.getElementById('ar-cards').style.display = 'block';

    // Show Arabic day text, hide English day text
    document.querySelectorAll('.day-text-en').forEach(el => el.style.display = 'none');
    document.querySelectorAll('.day-text-ar').forEach(el => el.style.display = 'inline');

    document.documentElement.lang = 'ar';
  }

  // Re-apply current filter
  const activeFilter = document.querySelector(`#filter-${lang} .filter-btn.active`);
  if (activeFilter) {
    // Get the filter type from the button's data-type attribute or text content
    let filterType = 'all';

    // Check if button has data-type attribute
    if (activeFilter.dataset.type) {
      filterType = activeFilter.dataset.type;
    } else {
      // Fallback to text content detection
      const filterText = activeFilter.textContent.toLowerCase();
      if (filterText.includes('all') || filterText.includes('جميع')) filterType = 'all';
      else if (filterText.includes('meat') || filterText.includes('لحوم')) filterType = 'meat';
      else if (filterText.includes('chicken') || filterText.includes('دجاج')) filterType = 'chicken';
      else if (filterText.includes('seafood') || filterText.includes('مأكولات')) filterType = 'seafood';
      else if (filterText.includes('veggie') || filterText.includes('خضروات')) filterType = 'veggie';
    }

    // Create a mock event
    const mockEvent = { target: activeFilter };
    setTimeout(() => {
      filterDay(filterType, mockEvent);

      // After filtering, try to show the previously active day if it exists and we're not skipping
      if (!skipDaySelection && activeDay) {
        const targetDot = document.getElementById('btn-' + activeDay);
        if (targetDot && targetDot.style.display !== 'none') {
          // Small delay to ensure filter is applied
          setTimeout(() => {
            showDay(activeDay, targetDot);
          }, 50);
        }
      }
    }, 50);
  } else {
    // Show the previously active day or first day (only if we're not skipping)
    if (!skipDaySelection) {
      if (activeDay) {
        const targetDot = document.getElementById('btn-' + activeDay);
        if (targetDot) {
          // Make sure the dot is visible
          targetDot.style.display = 'inline-flex';
          setTimeout(() => {
            showDay(activeDay, targetDot);
          }, 50);
        } else {
          // Fallback to first dot
          const firstDot = document.querySelector('.nav-dot');
          if (firstDot) {
            const dayId = firstDot.id.replace('btn-', '');
            showDay(dayId, firstDot);
          }
        }
      } else {
        // Show first day
        const firstDot = document.querySelector('.nav-dot');
        if (firstDot) {
          const dayId = firstDot.id.replace('btn-', '');
          showDay(dayId, firstDot);
        }
      }
    }
  }

  // Save preference
  localStorage.setItem('preferred-language', lang);
}

// Load saved preference on page load
document.addEventListener('DOMContentLoaded', function() {
  const savedLang = localStorage.getItem('preferred-language') || 'en';

  // First, switch language without selecting any day
  switchLanguage(savedLang, true);

  // Then check if there's a hash in the URL
  setTimeout(function() {
    const hash = window.location.hash.substring(1); // Remove the # symbol
    if (hash && hash.startsWith('day-')) {
      const dayNumber = hash.replace('day-', '');

      // Find the dot button for this day
      const targetDot = document.getElementById('btn-' + dayNumber);
      if (targetDot) {
        // Get current language and active filter
        const currentLang = document.querySelector('.lang-btn.active')?.textContent.includes('العربية') ? 'ar' : 'en';
        const activeFilter = document.querySelector(`#filter-${currentLang} .filter-btn.active`);

        // Get the card for this day
        const cardId = currentLang === 'ar' ? `day-ar-${dayNumber}` : `day-${dayNumber}`;
        const card = document.getElementById(cardId);

        if (activeFilter && card) {
          // Get the current filter type
          let currentFilterType = 'all';
          if (activeFilter.dataset.type) {
            currentFilterType = activeFilter.dataset.type;
          }

          // Check if this day matches the current filter
          if (currentFilterType === 'all' || card.getAttribute('data-type') === currentFilterType) {
            // Day matches filter, show it directly
            showDay(dayNumber, targetDot);
          } else {
            // Day doesn't match filter, set filter to 'all' first
            const allFilterBtn = document.querySelector(`#filter-${currentLang} .filter-btn:first-child`);
            if (allFilterBtn) {
              const mockEvent = { target: allFilterBtn };
              filterDay('all', mockEvent);
              // Small delay to allow filter to apply, then show the day
              setTimeout(() => {
                showDay(dayNumber, targetDot);
              }, 100);
            }
          }
        } else {
          // No active filter or card, just show the day
          showDay(dayNumber, targetDot);
        }
      }
    } else {
      // No hash in URL, show first day
      const firstDot = document.querySelector('.nav-dot');
      if (firstDot) {
        const dayId = firstDot.id.replace('btn-', '');
        showDay(dayId, firstDot);
      }
    }
  }, 250); // Slightly longer delay to ensure everything is loaded
});
</script>
{% endif %}

