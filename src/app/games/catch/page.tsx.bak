"use client";

import Link from "next/link";
import { useEffect, useRef, useState } from "react";
import { useLang } from "@/components/LanguageProvider";
import { ar } from "@/lib/ar";
import GameHeader from "@/components/GameHeader";

type Item = {
  id: number;
  x: number;
  y: number;
  speed: number;
  emoji: string;
  isBad: boolean;
};

const GOOD_ITEMS = ["🥔", "🧅", "🍅", "🥕", "🥦", "🌽", "🍄", "🫑"];
const BAD_ITEM = "👟";
const BASKET_WIDTH = 100;
const BASKET_HEIGHT = 50;
const ITEM_SIZE = 40;

export default function CatchGamePage() {
  const { lang } = useLang();
  const isAr = lang === "ar";

  const gameAreaRef = useRef<HTMLDivElement>(null);
  const basketRef = useRef<HTMLDivElement>(null);
  const requestRef = useRef<number>(0);
  const lastTimeRef = useRef<number>(0);
  const spawnTimerRef = useRef<number>(0);
  const itemsRef = useRef<Item[]>([]);
  const basketXRef = useRef<number>(0);
  const isPlayingRef = useRef<boolean>(false);
  const livesRef = useRef<number>(3);
  const idCounterRef = useRef<number>(0);

  const [score, setScore] = useState(0);
  const [lives, setLives] = useState(3);
  const [gameOver, setGameOver] = useState(false);
  const [showRules, setShowRules] = useState(false);
  const [renderItems, setRenderItems] = useState<Item[]>([]);

  // keep livesRef in sync for the loop closure
  useEffect(() => {
    livesRef.current = lives;
  }, [lives]);

  const stopGame = () => {
    isPlayingRef.current = false;
    if (requestRef.current) cancelAnimationFrame(requestRef.current);
    requestRef.current = 0;
    itemsRef.current = [];
    setRenderItems([]);
  };

  const loseLife = () => {
    const next = livesRef.current - 1;
    livesRef.current = next;
    setLives(next);
    if (next <= 0) {
      stopGame();
      setGameOver(true);
    }
  };

  const spawnItem = (width: number) => {
    const isBad = Math.random() < 0.2;
    const emoji = isBad ? BAD_ITEM : GOOD_ITEMS[Math.floor(Math.random() * GOOD_ITEMS.length)];
    const x = Math.random() * (width - ITEM_SIZE);
    const speed = 0.12 + Math.random() * 0.08; // px per ms
    itemsRef.current.push({
      id: idCounterRef.current++,
      x,
      y: -ITEM_SIZE,
      speed,
      emoji,
      isBad,
    });
  };

  const loop = (time: number) => {
    if (!isPlayingRef.current) return;
    const area = gameAreaRef.current;
    if (!area) return;

    if (!lastTimeRef.current) lastTimeRef.current = time;
    const dt = time - lastTimeRef.current;
    lastTimeRef.current = time;

    const width = area.clientWidth;
    const height = area.clientHeight;

    // spawn every ~750ms
    spawnTimerRef.current += dt;
    if (spawnTimerRef.current > 750) {
      spawnTimerRef.current = 0;
      spawnItem(width);
    }

    const basketLeft = basketXRef.current - BASKET_WIDTH / 2;
    const basketRight = basketXRef.current + BASKET_WIDTH / 2;
    const basketTop = height - 20 - BASKET_HEIGHT;

    const survivors: Item[] = [];
    for (const it of itemsRef.current) {
      it.y += it.speed * dt;

      // collision with basket top area
      const itLeft = it.x;
      const itRight = it.x + ITEM_SIZE;
      const itBottom = it.y + ITEM_SIZE;

      if (itBottom >= basketTop && it.y <= basketTop + BASKET_HEIGHT &&
          itRight >= basketLeft && itLeft <= basketRight) {
        if (it.isBad) {
          loseLife();
        } else {
          setScore((s) => s + 1);
        }
        continue; // caught — remove
      }

      // missed (fell past the bottom)
      if (it.y > height) {
        if (!it.isBad) loseLife();
        continue;
      }

      survivors.push(it);
    }
    itemsRef.current = survivors;
    setRenderItems([...survivors]);

    if (isPlayingRef.current) {
      requestRef.current = requestAnimationFrame(loop);
    }
  };

  const startGame = () => {
    stopGame();
    setScore(0);
    setLives(3);
    livesRef.current = 3;
    setGameOver(false);
    lastTimeRef.current = 0;
    spawnTimerRef.current = 0;
    idCounterRef.current = 0;
    itemsRef.current = [];

    // center basket
    const area = gameAreaRef.current;
    if (area) {
      const cx = area.clientWidth / 2;
      basketXRef.current = cx;
      if (basketRef.current) basketRef.current.style.left = `${cx}px`;
    }

    isPlayingRef.current = true;
    requestRef.current = requestAnimationFrame(loop);
  };

  // auto-start on mount
  useEffect(() => {
    const t = setTimeout(() => startGame(), 50);
    return () => {
      clearTimeout(t);
      stopGame();
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const handleMove = (clientX: number) => {
    const area = gameAreaRef.current;
    const basket = basketRef.current;
    if (!area || !basket) return;
    const rect = area.getBoundingClientRect();
    const x = clientX - rect.left;
    const half = BASKET_WIDTH / 2;
    const clamped = Math.max(half, Math.min(rect.width - half, x));
    basketXRef.current = clamped;
    basket.style.left = `${clamped}px`;
  };

  return (
    <div
      style={{
        position: "relative",
        height: "100dvh",
        display: "flex",
        flexDirection: "column",
        background: "var(--bg)",
        overflow: "hidden",
      }}
    >
      <Link
        href="/games"
        style={{
          position: "absolute",
          top: 12,
          insetInlineEnd: 12,
          zIndex: 50,
          background: "var(--surface)",
          border: "1px solid var(--line)",
          borderRadius: 10,
          padding: "8px 14px",
          fontSize: 14,
          fontWeight: 600,
          textDecoration: "none",
          color: "var(--ink)",
        }}
      >
        ✕ {isAr ? "خروج" : "Exit"}
      </Link>

      <GameHeader
        title="Catch the Ingredients"
        titleAr="اجمع المكونات"
        onNewGame={startGame}
        onShowRules={() => setShowRules(true)}
        score={score}
        best={lives}
      />

      <div
        ref={gameAreaRef}
        onMouseMove={(e) => handleMove(e.clientX)}
        onTouchMove={(e) => handleMove(e.touches[0].clientX)}
        onTouchStart={(e) => handleMove(e.touches[0].clientX)}
        style={{
          position: "relative",
          flex: 1,
          width: "100%",
          overflow: "hidden",
          touchAction: "none",
        }}
      >
        {renderItems.map((it) => (
          <div
            key={it.id}
            style={{
              position: "absolute",
              left: it.x,
              top: it.y,
              width: ITEM_SIZE,
              height: ITEM_SIZE,
              fontSize: 32,
              lineHeight: `${ITEM_SIZE}px`,
              textAlign: "center",
              pointerEvents: "none",
              userSelect: "none",
            }}
          >
            {it.emoji}
          </div>
        ))}

        <div
          ref={basketRef}
          style={{
            position: "absolute",
            bottom: 20,
            width: BASKET_WIDTH,
            height: BASKET_HEIGHT,
            background: "#8b5a2b",
            borderRadius: "0 0 40px 40px",
            border: "4px solid #5c3a1a",
            borderTop: "none",
            transform: "translateX(-50%)",
            zIndex: 5,
            boxShadow:
              "inset 0 -10px 20px rgba(0,0,0,0.5), 0 10px 20px rgba(0,0,0,0.5)",
          }}
        />
      </div>

      {showRules && (
        <div
          style={{
            position: "fixed",
            inset: 0,
            background: "rgba(0,0,0,0.85)",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            padding: 20,
            zIndex: 100,
          }}
        >
          <div style={{ background: "var(--surface)", padding: 32, borderRadius: 20, maxWidth: 400, width: "100%" }}>
            <h2 style={{ marginTop: 0 }}>{isAr ? ar.catch.rulesTitle : "Game Rules"}</h2>
            <p
              style={{ fontSize: "0.9rem", lineHeight: 1.5, color: "var(--ink-soft)" }}
              dangerouslySetInnerHTML={{
                __html: isAr
                  ? ar.catch.rulesText
                  : "<strong>Goal:</strong> Move the basket to catch falling ingredients.<br><br><strong>Lives:</strong> You have 3 hearts. If an ingredient falls or you catch a shoe (👟), you lose a heart.<br><br><strong>Score:</strong> Each ingredient you catch gives you a point!",
              }}
            />
            <button
              className="btn btn-primary"
              onClick={() => setShowRules(false)}
              style={{ width: "100%", marginTop: 16 }}
            >
              {isAr ? ar.catch.gotIt : "Got it"}
            </button>
          </div>
        </div>
      )}

      {gameOver && (
        <div
          style={{
            position: "fixed",
            inset: 0,
            background: "rgba(0,0,0,0.85)",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            padding: 20,
            zIndex: 100,
          }}
        >
          <div style={{ background: "var(--surface)", padding: 32, borderRadius: 20, maxWidth: 400, width: "100%", textAlign: "center" }}>
            <h2 style={{ fontFamily: "var(--font-head)", fontSize: "2rem", margin: "0 0 8px 0" }}>
              {isAr ? ar.catch.gameOver : "Game Over"}
            </h2>
            <p style={{ color: "var(--muted)", marginBottom: 24 }}>
              {isAr ? ar.catch.youCaught : "You caught"}
            </p>
            <div style={{ fontSize: "3rem", fontWeight: 700, color: "var(--accent)", marginBottom: 24 }}>
              {score}
            </div>
            <p style={{ color: "var(--muted)", marginBottom: 24 }}>
              {isAr ? ar.catch.ingredientsCount : "ingredients!"}
            </p>
            <button className="btn btn-primary" onClick={startGame} style={{ width: "100%" }}>
              {isAr ? ar.catch.playAgain : "Play Again"}
            </button>
          </div>
        </div>
      )}
    </div>
  );
}
