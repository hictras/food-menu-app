  "steps": [
    {
      "step_number": 1,
      "instruction": "في قدر كبير، سخني السمنة أو الزيت على نار متوسطة. أضيفي قطع اللحم وحمريها من جميع الجهات حتى يتغير لونها."
    },
    {
      "step_number": 2,
      "instruction": "أضيفي البصل المفروم والثوم وقلبي حتى يذبلا ويصبحا طريين."
    },
    {
      "step_number": 3,
      "instruction": "أضيفي معجون الطماطم والطماطم المقطعة، وقلبي لمدة دقيقتين."
    },
    {
      "step_number": 4,
      "instruction": "أضيفي اللوبية المقطعة، الملح، الفلفل الأسود، سبع بهارات، والقرفة. قلبي جيداً."
    },
    {
      "step_number": 5,
      "instruction": "أضيفي الماء أو المرق، وغطي القدر، واتركيه على نار هادئة لمدة 45-60 دقيقة حتى تنضج اللوبية واللحم (حسب نوع اللحم)."
    },
    {
      "step_number": 6,
      "instruction": "لتحضير الأرز: في قدر آخر، حمري الشعيرية في السمنة حتى تصبح ذهبية. أضيفي الأرز المغسول وقلبي لمدة دقيقة."
    },
    {
      "step_number": 7,
      "instruction": "أضيفي الماء الساخن والملح، واتركي الأرز يغلي ثم خففي النار وغطيه حتى ينضج (حوالي 15-20 دقيقة)."
    },
    {
      "step_number": 8,
      "instruction": "قدمي اللوبية باللحم ساخنة alongside الأرز المفلفل. يمكن تقديمها مع لبن أو سلطة خيار باللبن."
    }
  ],
